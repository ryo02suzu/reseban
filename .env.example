# ---- AI（使わないなら空のままでOK。レポートとルール判定はAIなしで動く）----
# bedrock = Amazon Bedrock 東京（推奨） / vertex = Google Cloud 東京 / anthropic = Anthropic API（国外・検証用）
AI_PROVIDER=
# AWS_REGION=ap-northeast-1          # bedrock のとき（認証は通常のAWS認証情報）
# VERTEX_REGION=asia-northeast1      # vertex のとき
# GOOGLE_CLOUD_PROJECT=              # vertex のとき
# ANTHROPIC_API_KEY=                 # anthropic のとき
# AI_MODEL=                          # 省略時 claude-opus-5（bedrock は anthropic.claude-opus-5）

# ---- ログイン（院外のサーバーに置くときは必ず設定）----
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# ---- 保存先（省略時 ./data）----
# RESEBAN_DATA_DIR=/var/lib/reseban
