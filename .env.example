# ---- 必須（本番）----
# PostgreSQL（例：Amazon RDS for PostgreSQL 東京リージョン、保存時暗号化あり）
# 未設定なら開発用の組み込み DB（./data/pglite）を使う
DATABASE_URL=
# 保存データの暗号化キー（32バイトを base64。openssl rand -base64 32）。Secrets Manager 等で管理し、紛失するとデータを復号できない
DATA_ENCRYPTION_KEY=
# 招待リンクの表示などに使う公開URL
APP_URL=https://reseban.example.jp

# ---- AI（使わないなら空。点検はAIなしで動く）----
# bedrock = Amazon Bedrock 東京（推奨） / vertex = Google Cloud 東京 / anthropic = Anthropic API（国外・検証用）
AI_PROVIDER=
# AWS_REGION=ap-northeast-1          # bedrock のとき（認証はタスクロール等の通常のAWS認証情報）
# VERTEX_REGION=asia-northeast1      # vertex のとき
# GOOGLE_CLOUD_PROJECT=              # vertex のとき
# ANTHROPIC_API_KEY=                 # anthropic のとき
# AI_MODEL=                          # 省略時 claude-opus-5（bedrock は anthropic.claude-opus-5）

# ---- 任意 ----
# SESSION_IDLE_MINUTES=60            # 操作がなければ自動ログアウト（分）
# SESSION_MAX_HOURS=12               # ログインの最長時間
# REQUIRE_2FA=1                      # 全員に2段階認証を必須にする
# RUN_RETENTION_MONTHS=36            # チェック結果の保存期間（月）
# DATABASE_POOL_MAX=10
# DATABASE_SSL=false                 # RDS 以外で TLS を使わない場合のみ
# RESEBAN_DATA_DIR=./data            # 開発用DB・開発用鍵の置き場所
# INSECURE_COOKIES=1                 # HTTPS を使わないローカル検証（docker compose）のときだけ。本番では絶対に設定しない
# RESEBAN_DISABLE_JOBS=1             # 自動削除などの定期処理を止める（テスト用）
